# Match physical DualShock 4 controllers only if the translator service is active and not disabled ("none" emulation)

# Bluetooth physical controllers (always bus 0005)
TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="hidraw", KERNELS=="0005:054C:05C4.*", \
  MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}="", \
  ENV{ID_BUS}="", ENV{ID_VENDOR_ID}="", ENV{ID_MODEL_ID}="", ENV{ID_MODEL}="", ENV{ID_VENDOR}=""

TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="hidraw", KERNELS=="0005:054C:09CC.*", \
  MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}="", \
  ENV{ID_BUS}="", ENV{ID_VENDOR_ID}="", ENV{ID_MODEL_ID}="", ENV{ID_MODEL}="", ENV{ID_VENDOR}=""

TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="input", KERNELS=="0005:054C:05C4.*", \
  MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}=""

TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="input", KERNELS=="0005:054C:09CC.*", \
  MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}=""

# Battery of a Bluetooth-connected physical controller.
#
# Fallback only under the unlink hide method, which parks the controller on
# hid-generic so this power_supply is never registered in the first place
# (see swap_bt_driver_to_generic() in main.cpp) -- this still matters when
# that swap fails and the connection falls back to hid-playstation, and for
# the legacy/unbind methods, which always leave hid-playstation bound.
#
# hid-playstation registers a power_supply device
# ("ps-controller-battery-<MAC>") for every controller it binds. On
# Bluetooth the driver necessarily stays bound (see the unbind/unlink hide
# methods: bluetoothd owns the L2CAP session, so the driver can't be
# unbound the way it is on USB), so that battery is registered for the
# physical pad and shows up in UPower -- and therefore in the desktop's
# battery indicator -- as a second controller battery alongside the
# emulated device's own. This is a sysfs class device with no /dev node at
# all, so neither the permission-based nor the node-unlinking hide methods
# can touch it; UPOWER_IGNORE is the supported way to keep it out of
# UPower's device list.
#
# Only bus 0005 is matched, which excludes the emulated controller's
# battery by construction: that one hangs off our own bus-0003 device
# (uhid or dummy_hcd), and it *should* stay visible -- a real DS4 reports
# a battery, so hiding it would make the emulated pad look wrong.
#
# Note this hides the battery from UPower only. The power_supply attributes
# stay readable in sysfs for anything that goes looking there directly;
# removing them outright isn't possible without unbinding the driver. That
# is not a theoretical gap: MangoHud, for one, scans /sys/class/power_supply
# for "ps-controller"/"sony_controller" entries itself and never asks
# UPower, so only the unlink method hides the battery from it -- by keeping
# hid-playstation off the pad entirely (MAC squat), or failing that by moving
# it onto hid-generic after the fact.
TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="power_supply", KERNELS=="0005:054C:05C4.*", \
  ENV{UPOWER_IGNORE}="1"

TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="power_supply", KERNELS=="0005:054C:09CC.*", \
  ENV{UPOWER_IGNORE}="1"

# USB physical controllers (bus 0003). Matched via the USB device's own
# ATTRS{idVendor}/ATTRS{idProduct} instead of DRIVERS=="usb", because combined
# KERNELS+DRIVERS parent-matching requires BOTH keys to match the SAME
# ancestor device. On kernels using hid-playstation (which handles DS4/DualSense
# instead of the older hid-sony), there's an intermediate "hid" class device
# between the hidraw node and the real USB device node: KERNELS=="0003:054C:*"
# only matches that intermediate hid device (DRIVERS=="playstation" there, not
# "usb"), while DRIVERS=="usb" only matches the USB device two levels further
# up. No single device satisfies both, so the rule silently never fired and
# the physical node kept its default MODE=0660 + uaccess ACL (see
# /usr/lib/udev/rules.d/60-inputplumber-uaccess.rules) letting unprivileged
# processes (e.g. games under Wine, Steam) open it directly. ATTRS{idVendor}/
# idProduct both live on the USB device node itself, so a single ancestor
# match works regardless of which intermediate HID driver is in use, and it
# still never matches the virtual UHID node since that has no USB ancestor
# at all.
#
# DEVPATH!="/devices/platform/dummy_hcd.0/*": the functionfs backend
# emulates a *genuinely enumerated* USB device with this exact same
# idVendor/idProduct (impersonating real hardware is the whole point), bound
# to dummy_hcd's virtual USB bus -- without this guard these ATTRS-only rules
# also match and hide our own emulated controller right alongside the real
# physical one, since idVendor/idProduct alone can't tell them apart. Real
# hardware never appears under this DEVPATH, so excluding it is safe.
TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="05c4", DEVPATH!="/devices/platform/dummy_hcd.0/*", \
  MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}="", \
  ENV{ID_BUS}="", ENV{ID_VENDOR_ID}="", ENV{ID_MODEL_ID}="", ENV{ID_MODEL}="", ENV{ID_VENDOR}=""

TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="09cc", DEVPATH!="/devices/platform/dummy_hcd.0/*", \
  MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}="", \
  ENV{ID_BUS}="", ENV{ID_VENDOR_ID}="", ENV{ID_MODEL_ID}="", ENV{ID_MODEL}="", ENV{ID_VENDOR}=""

TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="input", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="05c4", DEVPATH!="/devices/platform/dummy_hcd.0/*", \
  MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}=""

TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="input", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="09cc", DEVPATH!="/devices/platform/dummy_hcd.0/*", \
  MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}=""

# -----------------------------------------------------------------------------
# Virtual controller USB emulation properties injection (so Steam/Proton/Wine recognize it as a real USB gamepad)
#
# KERNELS is pinned to bus 0003 (the daemon always creates its UHID device
# with bus=BUS_USB) rather than wildcarded to "any bus". A Bluetooth-paired
# *physical* controller is also bridged through the kernel's own internal
# uhid mechanism and shows up under this same /devices/virtual/misc/uhid/*
# DEVPATH with its real bus, 0005 -- a wildcarded KERNELS=="*:054C:05C4.*"
# matched that too, forcing MODE=0666 + re-adding the uaccess/seat tags on
# the real physical device and undoing the hiding rules above for it.

# Match virtual DualShock 4 controller (UHID, bus 0003 only, force ID_BUS=usb)
SUBSYSTEM=="input", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="0003:054C:05C4.*", \
  ENV{ID_BUS}="usb", ENV{ID_VENDOR_ID}="054c", ENV{ID_MODEL_ID}="05c4", \
  ENV{ID_MODEL}="Wireless_Controller", ENV{ID_MODEL_ENC}="Wireless\x20Controller", \
  ENV{ID_VENDOR}="Sony_Computer_Entertainment", ENV{ID_VENDOR_ENC}="Sony\x20Computer\x20Entertainment", \
  ENV{ID_SERIAL}="Sony_Computer_Entertainment_Wireless_Controller", ENV{ID_REVISION}="0100", ENV{ID_TYPE}="hid", \
  ENV{ID_USB_MODEL}="Wireless_Controller", ENV{ID_USB_MODEL_ENC}="Wireless\x20Controller", ENV{ID_USB_MODEL_ID}="05c4", \
  ENV{ID_USB_VENDOR}="Sony_Computer_Entertainment", ENV{ID_USB_VENDOR_ENC}="Sony\x20Computer\x20Entertainment", ENV{ID_USB_VENDOR_ID}="054c", \
  ENV{ID_USB_SERIAL}="Sony_Computer_Entertainment_Wireless_Controller", ENV{ID_USB_REVISION}="0100", ENV{ID_USB_TYPE}="hid", \
  ENV{ID_USB_INTERFACES}=":030000:", ENV{ID_USB_INTERFACE_NUM}="00", ENV{ID_USB_DRIVER}="usbhid", \
  SYMLINK+="input/by-id/usb-Sony_Computer_Entertainment_Wireless_Controller-event-joystick"

KERNEL=="js*", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="0003:054C:05C4.*", \
  ENV{ID_BUS}="usb", ENV{ID_VENDOR_ID}="054c", ENV{ID_MODEL_ID}="05c4", \
  ENV{ID_MODEL}="Wireless_Controller", ENV{ID_VENDOR}="Sony_Computer_Entertainment", \
  ENV{ID_SERIAL}="Sony_Computer_Entertainment_Wireless_Controller", \
  ENV{ID_USB_MODEL}="Wireless_Controller", ENV{ID_USB_MODEL_ID}="05c4", \
  ENV{ID_USB_VENDOR}="Sony_Computer_Entertainment", ENV{ID_USB_VENDOR_ID}="054c", \
  ENV{ID_USB_INTERFACE_NUM}="00", ENV{ID_USB_DRIVER}="usbhid", \
  SYMLINK+="input/by-id/usb-Sony_Computer_Entertainment_Wireless_Controller-joystick"

SUBSYSTEM=="hidraw", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="0003:054C:05C4.*", \
  MODE="0666", TAG+="uaccess", TAG+="seat", \
  ENV{ID_BUS}="usb", ENV{ID_VENDOR_ID}="054c", ENV{ID_MODEL_ID}="05c4", \
  ENV{ID_MODEL}="Wireless_Controller", ENV{ID_MODEL_ENC}="Wireless\x20Controller", \
  ENV{ID_VENDOR}="Sony_Computer_Entertainment", ENV{ID_VENDOR_ENC}="Sony\x20Computer\x20Entertainment", \
  ENV{ID_SERIAL}="Sony_Computer_Entertainment_Wireless_Controller", ENV{ID_REVISION}="0100", ENV{ID_TYPE}="hid", \
  ENV{ID_USB_MODEL}="Wireless_Controller", ENV{ID_USB_MODEL_ENC}="Wireless\x20Controller", ENV{ID_USB_MODEL_ID}="05c4", \
  ENV{ID_USB_VENDOR}="Sony_Computer_Entertainment", ENV{ID_USB_VENDOR_ENC}="Sony\x20Computer\x20Entertainment", ENV{ID_USB_VENDOR_ID}="054c", \
  ENV{ID_USB_SERIAL}="Sony_Computer_Entertainment_Wireless_Controller", ENV{ID_USB_REVISION}="0100", ENV{ID_USB_TYPE}="hid", \
  ENV{ID_USB_INTERFACES}=":030000:", ENV{ID_USB_INTERFACE_NUM}="00", ENV{ID_USB_DRIVER}="usbhid", \
  ENV{ID_VENDOR_FROM_DATABASE}="Sony Corp.", ENV{ID_MODEL_FROM_DATABASE}="DualShock 4 [CUH-ZCT1x]", \
  ENV{SOUND_FORM_FACTOR}="controller"

# Match virtual DualSense controller (UHID, bus 0003 only, force ID_BUS=usb)
SUBSYSTEM=="input", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="0003:054C:0CE6.*", \
  ENV{ID_BUS}="usb", ENV{ID_VENDOR_ID}="054c", ENV{ID_MODEL_ID}="0ce6", \
  ENV{ID_MODEL}="Wireless_Controller", ENV{ID_MODEL_ENC}="Wireless\x20Controller", \
  ENV{ID_VENDOR}="Sony_Interactive_Entertainment", ENV{ID_VENDOR_ENC}="Sony\x20Interactive\x20Entertainment", \
  ENV{ID_SERIAL}="Sony_Interactive_Entertainment_DualSense_Wireless_Controller", ENV{ID_REVISION}="0100", ENV{ID_TYPE}="hid", \
  ENV{ID_USB_MODEL}="Wireless_Controller", ENV{ID_USB_MODEL_ENC}="Wireless\x20Controller", ENV{ID_USB_MODEL_ID}="0ce6", \
  ENV{ID_USB_VENDOR}="Sony_Interactive_Entertainment", ENV{ID_USB_VENDOR_ENC}="Sony\x20Interactive\x20Entertainment", ENV{ID_USB_VENDOR_ID}="054c", \
  ENV{ID_USB_SERIAL}="Sony_Interactive_Entertainment_DualSense_Wireless_Controller", ENV{ID_USB_REVISION}="0100", ENV{ID_USB_TYPE}="hid", \
  ENV{ID_USB_INTERFACES}=":030000:", ENV{ID_USB_INTERFACE_NUM}="00", ENV{ID_USB_DRIVER}="usbhid", \
  SYMLINK+="input/by-id/usb-Sony_Interactive_Entertainment_DualSense_Wireless_Controller-event-joystick"

KERNEL=="js*", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="0003:054C:0CE6.*", \
  ENV{ID_BUS}="usb", ENV{ID_VENDOR_ID}="054c", ENV{ID_MODEL_ID}="0ce6", \
  ENV{ID_MODEL}="Wireless_Controller", ENV{ID_VENDOR}="Sony_Interactive_Entertainment", \
  ENV{ID_SERIAL}="Sony_Interactive_Entertainment_DualSense_Wireless_Controller", \
  ENV{ID_USB_MODEL}="Wireless_Controller", ENV{ID_USB_MODEL_ID}="0ce6", \
  ENV{ID_USB_VENDOR}="Sony_Interactive_Entertainment", ENV{ID_USB_VENDOR_ID}="054c", \
  ENV{ID_USB_INTERFACE_NUM}="00", ENV{ID_USB_DRIVER}="usbhid", \
  SYMLINK+="input/by-id/usb-Sony_Interactive_Entertainment_DualSense_Wireless_Controller-joystick"

SUBSYSTEM=="hidraw", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="0003:054C:0CE6.*", \
  MODE="0666", TAG+="uaccess", TAG+="seat", \
  ENV{ID_BUS}="usb", ENV{ID_VENDOR_ID}="054c", ENV{ID_MODEL_ID}="0ce6", \
  ENV{ID_MODEL}="Wireless_Controller", ENV{ID_MODEL_ENC}="Wireless\x20Controller", \
