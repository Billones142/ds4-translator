  ENV{ID_VENDOR}="Sony_Interactive_Entertainment", ENV{ID_VENDOR_ENC}="Sony\x20Interactive\x20Entertainment", \
  ENV{ID_SERIAL}="Sony_Interactive_Entertainment_DualSense_Wireless_Controller", ENV{ID_REVISION}="0100", ENV{ID_TYPE}="hid", \
  ENV{ID_USB_MODEL}="Wireless_Controller", ENV{ID_USB_MODEL_ENC}="Wireless\x20Controller", ENV{ID_USB_MODEL_ID}="0ce6", \
