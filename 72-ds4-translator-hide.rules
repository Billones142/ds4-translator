# Match physical DualShock 4 controllers only if the translator service is active and not disabled ("none" emulation)

# Bluetooth physical controllers (always bus 0005)
TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="hidraw", KERNELS=="0005:054C:05C4.*", MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat"
TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="hidraw", KERNELS=="0005:054C:09CC.*", MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat"
TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="input", KERNELS=="0005:054C:05C4.*", MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat"
TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="input", KERNELS=="0005:054C:09CC.*", MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat"

# USB physical controllers (bus 0003, but has a parent in the usb subsystem to avoid matching virtual uhid)
TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="hidraw", KERNELS=="0003:054C:05C4.*", DRIVERS=="usb", MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat"
TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="hidraw", KERNELS=="0003:054C:09CC.*", DRIVERS=="usb", MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat"
TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="input", KERNELS=="0003:054C:05C4.*", DRIVERS=="usb", MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat"
TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="input", KERNELS=="0003:054C:09CC.*", DRIVERS=="usb", MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat"

# -----------------------------------------------------------------------------
# Virtual controller USB emulation properties injection (so Steam/Proton/Wine recognize it as a real USB gamepad)

# Match virtual DualShock 4 controller
SUBSYSTEM=="input", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="0003:054C:05C4.*", ENV{ID_BUS}="usb", ENV{ID_VENDOR_ID}="054c", ENV{ID_MODEL_ID}="05c4", ENV{ID_MODEL}="Wireless_Controller", ENV{ID_VENDOR}="Sony_Computer_Entertainment", ENV{ID_USB_INTERFACE_NUM}="00", SYMLINK+="input/by-id/usb-Sony_Computer_Entertainment_Wireless_Controller-event-joystick"
KERNEL=="js*", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="0003:054C:05C4.*", ENV{ID_BUS}="usb", ENV{ID_VENDOR_ID}="054c", ENV{ID_MODEL_ID}="05c4", ENV{ID_MODEL}="Wireless_Controller", ENV{ID_VENDOR}="Sony_Computer_Entertainment", ENV{ID_USB_INTERFACE_NUM}="00", SYMLINK+="input/by-id/usb-Sony_Computer_Entertainment_Wireless_Controller-joystick"

# Hide the virtual DualShock 4 hidraw node to force Winebus/Proton to fall back to the event-based (XInput/SDL) backend, preventing it from getting stuck on the empty manufacturer name
SUBSYSTEM=="hidraw", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="0003:054C:05C4.*", MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat"

# Match virtual DualSense controller
SUBSYSTEM=="input", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="0003:054C:0CE6.*", ENV{ID_BUS}="usb", ENV{ID_VENDOR_ID}="054c", ENV{ID_MODEL_ID}="0ce6", ENV{ID_MODEL}="Wireless_Controller", ENV{ID_VENDOR}="Sony_Interactive_Entertainment", ENV{ID_USB_INTERFACE_NUM}="00", SYMLINK+="input/by-id/usb-Sony_Interactive_Entertainment_DualSense_Wireless_Controller-event-joystick"
KERNEL=="js*", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="0003:054C:0CE6.*", ENV{ID_BUS}="usb", ENV{ID_VENDOR_ID}="054c", ENV{ID_MODEL_ID}="0ce6", ENV{ID_MODEL}="Wireless_Controller", ENV{ID_VENDOR}="Sony_Interactive_Entertainment", ENV{ID_USB_INTERFACE_NUM}="00", SYMLINK+="input/by-id/usb-Sony_Interactive_Entertainment_DualSense_Wireless_Controller-joystick"

# Hide the virtual DualSense hidraw node as well for consistency
SUBSYSTEM=="hidraw", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="0003:054C:0CE6.*", MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat"
