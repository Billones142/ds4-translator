# Match physical DualShock 4 controllers only if the translator service is active and not disabled ("none" emulation)

# Bluetooth physical controllers (always bus 0005)
TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="hidraw", KERNELS=="0005:054C:05C4.*", \
  MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}="", \
  ENV{ID_BUS}="", ENV{ID_VENDOR_ID}="", ENV{ID_MODEL_ID}="", ENV{ID_MODEL}="", ENV{ID_VENDOR}=""

TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="hidraw", KERNELS=="0005:054C:09CC.*", \
  MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}="", \
  ENV{ID_BUS}="", ENV{ID_VENDOR_ID}="", ENV{ID_MODEL_ID}="", ENV{ID_MODEL}="", ENV{ID_VENDOR}=""

TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="input", KERNELS=="0005:054C:05C4.*", \
  MODE="0660", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}=""

TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="input", KERNELS=="0005:054C:09CC.*", \
  MODE="0660", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}=""

# USB physical controllers (bus 0003). Matched via the USB device's own
# ATTRS{idVendor}/ATTRS{idProduct} instead of DRIVERS=="usb", because combined
# KERNELS+DRIVERS parent-matching requires BOTH keys to match the SAME
# ancestor device. On kernels using hid-playstation (which handles DS4/DualSense
# instead of the older hid-sony), there's an intermediate "hid" class device
# between the hidraw node and the real USB device node: KERNELS=="0003:054C:*"
# only matches that intermediate hid device (DRIVERS=="playstation" there, not
# "usb"), while DRIVERS=="usb" only matches the USB device two levels further
# up. No single device satisfies both, so the rule silently never fired and
# the physical node kept its default MODE=0660 + uaccess ACL (see
# /usr/lib/udev/rules.d/60-inputplumber-uaccess.rules) letting unprivileged
# processes (e.g. games under Wine, Steam) open it directly. ATTRS{idVendor}/
# idProduct both live on the USB device node itself, so a single ancestor
# match works regardless of which intermediate HID driver is in use, and it
# still never matches the virtual UHID node since that has no USB ancestor
# at all.
TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="05c4", \
  MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}="", \
  ENV{ID_BUS}="", ENV{ID_VENDOR_ID}="", ENV{ID_MODEL_ID}="", ENV{ID_MODEL}="", ENV{ID_VENDOR}=""

TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="09cc", \
  MODE="0600", OWNER="root", GROUP="root", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}="", \
  ENV{ID_BUS}="", ENV{ID_VENDOR_ID}="", ENV{ID_MODEL_ID}="", ENV{ID_MODEL}="", ENV{ID_VENDOR}=""

TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="input", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="05c4", \
  MODE="0660", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}=""

TEST=="/run/ds4-translator.sock", TEST!="/run/ds4-translator.none", SUBSYSTEM=="input", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="09cc", \
  MODE="0660", TAG-="uaccess", TAG-="seat", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT}=""

# -----------------------------------------------------------------------------
# Virtual controller USB emulation properties injection (so Steam/Proton/Wine recognize it as a real USB gamepad)

# Match virtual DualShock 4 controller (UHID - any bus, force ID_BUS=usb)
SUBSYSTEM=="input", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="*:054C:05C4.*", \
  ENV{ID_BUS}="usb", ENV{ID_VENDOR_ID}="054c", ENV{ID_MODEL_ID}="05c4", \
  ENV{ID_MODEL}="Wireless_Controller", ENV{ID_MODEL_ENC}="Wireless\x20Controller", \
  ENV{ID_VENDOR}="Sony_Computer_Entertainment", ENV{ID_VENDOR_ENC}="Sony\x20Computer\x20Entertainment", \
  ENV{ID_SERIAL}="Sony_Computer_Entertainment_Wireless_Controller", ENV{ID_REVISION}="0100", ENV{ID_TYPE}="hid", \
  ENV{ID_USB_MODEL}="Wireless_Controller", ENV{ID_USB_MODEL_ENC}="Wireless\x20Controller", ENV{ID_USB_MODEL_ID}="05c4", \
  ENV{ID_USB_VENDOR}="Sony_Computer_Entertainment", ENV{ID_USB_VENDOR_ENC}="Sony\x20Computer\x20Entertainment", ENV{ID_USB_VENDOR_ID}="054c", \
  ENV{ID_USB_SERIAL}="Sony_Computer_Entertainment_Wireless_Controller", ENV{ID_USB_REVISION}="0100", ENV{ID_USB_TYPE}="hid", \
  ENV{ID_USB_INTERFACES}=":030000:", ENV{ID_USB_INTERFACE_NUM}="00", ENV{ID_USB_DRIVER}="usbhid", \
  SYMLINK+="input/by-id/usb-Sony_Computer_Entertainment_Wireless_Controller-event-joystick"

KERNEL=="js*", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="*:054C:05C4.*", \
  ENV{ID_BUS}="usb", ENV{ID_VENDOR_ID}="054c", ENV{ID_MODEL_ID}="05c4", \
  ENV{ID_MODEL}="Wireless_Controller", ENV{ID_VENDOR}="Sony_Computer_Entertainment", \
  ENV{ID_SERIAL}="Sony_Computer_Entertainment_Wireless_Controller", \
  ENV{ID_USB_MODEL}="Wireless_Controller", ENV{ID_USB_MODEL_ID}="05c4", \
  ENV{ID_USB_VENDOR}="Sony_Computer_Entertainment", ENV{ID_USB_VENDOR_ID}="054c", \
  ENV{ID_USB_INTERFACE_NUM}="00", ENV{ID_USB_DRIVER}="usbhid", \
  SYMLINK+="input/by-id/usb-Sony_Computer_Entertainment_Wireless_Controller-joystick"

SUBSYSTEM=="hidraw", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="*:054C:05C4.*", \
  MODE="0666", TAG+="uaccess", TAG+="seat", \
  ENV{ID_BUS}="usb", ENV{ID_VENDOR_ID}="054c", ENV{ID_MODEL_ID}="05c4", \
  ENV{ID_MODEL}="Wireless_Controller", ENV{ID_MODEL_ENC}="Wireless\x20Controller", \
  ENV{ID_VENDOR}="Sony_Computer_Entertainment", ENV{ID_VENDOR_ENC}="Sony\x20Computer\x20Entertainment", \
  ENV{ID_SERIAL}="Sony_Computer_Entertainment_Wireless_Controller", ENV{ID_REVISION}="0100", ENV{ID_TYPE}="hid", \
  ENV{ID_USB_MODEL}="Wireless_Controller", ENV{ID_USB_MODEL_ENC}="Wireless\x20Controller", ENV{ID_USB_MODEL_ID}="05c4", \
  ENV{ID_USB_VENDOR}="Sony_Computer_Entertainment", ENV{ID_USB_VENDOR_ENC}="Sony\x20Computer\x20Entertainment", ENV{ID_USB_VENDOR_ID}="054c", \
  ENV{ID_USB_SERIAL}="Sony_Computer_Entertainment_Wireless_Controller", ENV{ID_USB_REVISION}="0100", ENV{ID_USB_TYPE}="hid", \
  ENV{ID_USB_INTERFACES}=":030000:", ENV{ID_USB_INTERFACE_NUM}="00", ENV{ID_USB_DRIVER}="usbhid", \
  ENV{ID_VENDOR_FROM_DATABASE}="Sony Corp.", ENV{ID_MODEL_FROM_DATABASE}="DualShock 4 [CUH-ZCT1x]", \
  ENV{SOUND_FORM_FACTOR}="controller"

# Match virtual DualSense controller (UHID - any bus, force ID_BUS=usb)
SUBSYSTEM=="input", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="*:054C:0CE6.*", \
  ENV{ID_BUS}="usb", ENV{ID_VENDOR_ID}="054c", ENV{ID_MODEL_ID}="0ce6", \
