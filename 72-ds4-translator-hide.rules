KERNEL=="js*", DEVPATH=="/devices/virtual/misc/uhid/*", KERNELS=="*:054C:0CE6.*", \
  ENV{ID_BUS}="usb", ENV{ID_VENDOR_ID}="054c", ENV{ID_MODEL_ID}="0ce6", \
