[Unit]
Description=DualShock 4 to Virtual Controller Translator Daemon
After=bluetooth.target
Wants=bluetooth.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
ExecStartPre=-/usr/bin/modprobe raw_gadget
ExecStartPre=-/usr/bin/modprobe dummy_hcd
ExecStartPre=-/usr/bin/modprobe libcomposite
ExecStart=/usr/local/bin/ds4-translator
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
