[Desktop Entry]
Type=Application
Name=DS4 Translator Applet
GenericName=Controller Tray Applet
Comment=Tray applet for switching the emulated controller type
# --background: register in the tray without opening the settings window.
Exec=ds4-translator-ui --background
Icon=input-gaming
Terminal=false
Categories=Settings;HardwareSettings;
StartupWMClass=ds4-translator-ui
# Autostart entry: not meant to be listed in the application menu next to
# the settings window, which launches the same binary.
NoDisplay=true
X-GNOME-Autostart-enabled=true
